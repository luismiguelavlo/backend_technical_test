#--------------------------------------------------------------------
# Example environment file — copy to `.env` and set real values.
#   cp .env.example .env
# Never commit `.env`. No real credentials here.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE (main)
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = ci4
database.default.username = changeme
database.default.password = changeme
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

#--------------------------------------------------------------------
# DATABASE (tests — used by PHPUnit)
#--------------------------------------------------------------------

database.tests.hostname = 127.0.0.1
database.tests.database = ci4_test
database.tests.username = changeme
database.tests.password = changeme
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# CORS — comma-separated list of allowed origins (no `*`).
# Empty → no cross-origin access. e.g. http://localhost:5173,https://app.example.com
#--------------------------------------------------------------------

CORS_ALLOWED_ORIGINS = http://localhost:5173
